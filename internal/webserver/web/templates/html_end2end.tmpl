{{define "e2esetup"}}{{template "header" .}}


	<script src="./js/min/end2end_admin.min.{{ template "js_e2eversion"}}.js"></script>
	<script src="./js/min/streamsaver.min.js"></script>
	<script src="./js/min/wasm_exec.min.js"></script>
	<script src="./js/min/admin.min.{{ template "js_admin_version"}}.js"></script>
	<script>
		document.title = "{{.PublicName}} - " + t("e2e_page_title");
	</script>

{{ if not .HasBeenSetup }}
      <div class="row">
        <div class="col">
		<div class="card" style="width: 50%;">
		  <div class="card-body">
		    <h2 class="card-title">{{ .Lang.T "e2e_title" }}</h2>
		    <br><br>
		    <p class="card-text">{{ .Lang.T "e2e_password_intro" }}<br>
			<b><kbd id="decryptionpw">{{ .Lang.T "e2e_generating" }}</kbd></b> <button type="button" id="downpw" class="btn btn-outline-light btn-sm" disabled><i class="bi bi-download"></i></button></p>
			<div id="errordiv" style="display:none">
				<span id="errormessage" style="color:red"></span>
				<br>
				<br>
			</div>
		    <b>{{ .Lang.T "e2e_password_warning" }}</b>
		    <br><br>{{ .Lang.T "e2e_reset_hint" }}
		    <br><br><button type="button" id="genbutton" class="btn btn-light" disabled onclick="window.location='./admin';">{{ .Lang.T "btn_continue" }}</button>
		    </div>
		  </div>
		</div>
	    </div>


    <script>
	function downloadKey(key) {
	    const uInt8 = new TextEncoder().encode(key)

	    const fileStream = streamSaver.createWriteStream('GokapiE2E.txt', {
		size: uInt8.byteLength
	    })

	    const writer = fileStream.getWriter()
	    writer.write(uInt8)
	    writer.close()

	}

function newKey() {
    localStorage.removeItem("e2ekey");
    let key;
    apiE2eMutexLockUnlock(false)
        .then(() => {
            try {
                key = GokapiE2EGetNewCipher(true);
                if (key instanceof Error) throw key;

                document.getElementById("decryptionpw").innerText = key;

                let data = GokapiE2EInfoEncrypt();
                if (data instanceof Error) throw data;

                return apiE2eStore(data);
            } catch (err) {
                throw err;
            }
        })
        .then(() => {
            localStorage.setItem("e2ekey", key);
            document.getElementById("downpw").onclick = function() {
                downloadKey(key);
            }
            document.getElementById("downpw").disabled = false;
            document.getElementById("genbutton").disabled = false;
        })
        .catch(err => {
            displayError(err);
        })
        .finally(() => {
            apiE2eMutexLockUnlock(true).catch(error => {
                console.error("Failed to release E2E mutex after newKey: " + error);
            });
        });
}

	loadWasm(newKey);

    </script>

{{ else }}
      <div class="row">
        <div class="col">
		<div class="card" style="width: 50%;">
		  <div class="card-body">
		    <h2 class="card-title">{{ .Lang.T "e2e_title" }}</h2>
		    <br><br>
		    <p class="card-text">{{ .Lang.T "e2e_existing_setup" }}</p>
		      <div class="mb-3"><br>
    			<input type="password" class="form-control" id="password" name="password">
			<div id="errordiv" style="display:none">
				<br>
				<span id="errormessage" style="color:red"></span>
				<br>
			</div>
		    <br><br><button type="button"  id="enterpwbutton" class="btn btn-light"  onclick="saveKey()" >{{ .Lang.T "btn_save" }}</button>
  			</div>
		  </div>
		</div>
	    </div>
    </div>


    <script>
	function saveKey() {
	    localStorage.removeItem("e2ekey");
	    let key = document.getElementById("password").value;
	    localStorage.setItem("e2ekey", key);

	    let output = GokapiE2ESetCipher(key);
	    if (output instanceof Error) {
		localStorage.removeItem("e2ekey");
		document.getElementById("password").value = "";
		displayError(output);
		return;
	    }
	    window.location = './admin';

	}

	loadWasm(function() {
	    document.getElementById("enterpwbutton").disabled = false;
	});

    </script>
{{ end }}
{{ template "pagename" "E2EGeneration"}}
{{ template "customjs" .}}
{{template "footer_version" . }}
{{end}}
