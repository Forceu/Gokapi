{{define "header"}}<!doctype html>
<html lang="{{.Lang.Code}}" class="h-100">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">

	<script>var gokapiTranslations = {{ .Lang.Js }};</script>
	<script src="./assets/dist/js/jquery.min.js"></script>
	<script src="./assets/dist/js/bootstrap.bundle.min.js"></script>
	<link href="./assets/dist/css/bootstrap.min.css" rel="stylesheet">
	<link rel="apple-touch-icon" sizes="180x180" href="./favicon-apple-touch-icon.png">
	<link rel="icon" type="image/png" sizes="32x32" href="./favicon-32x32.png">
	<link rel="icon" type="image/png" sizes="16x16" href="./favicon-16x16.png">
	<link rel="manifest" href="./site.webmanifest">
        <link href="./css/min/gokapi.min.{{ template "css_main"}}.css" rel="stylesheet">
	<link href="./assets/dist/icons/bootstrap-icons.min.css" rel="stylesheet">
	<script src="./js/min/all_public.min.js"></script>
{{ if .IsAdminView }}
        <title>{{.PublicName}} {{ .Lang.T "nav_admin_title" }}</title>
	<script src="./assets/dist/js/dropzone.min.js?v={{ template "js_dropzone_version"}}"></script>
	<script src="./assets/dist/js/clipboard.min.js"></script>
	<script src="./assets/dist/js/datatables.min.js"></script>
	<script src="./assets/dist/js/qrcode.min.js"></script>
	<script src="./assets/dist/js/flatpickr.min.js"></script>
	<link  href="./assets/dist/css/dropzone.min.v2.css" rel="stylesheet">
	<link  href="./assets/dist/css/datatables.min.css" rel="stylesheet">
	<link  href="./assets/dist/css/flatpickr.min.css" rel="stylesheet">
	<link  href="./assets/dist/css/flatpickr.dark.min.css" rel="stylesheet">
	<style>
		.masthead-brand {
			float: left;
		}
		.nav-masthead {
			float: right;
		}
	</style>
    {{ if .CustomContent.UseCustomCss }}
	<link  href="./custom/custom.v{{.CustomContent.Version}}.css" rel="stylesheet">
    {{ end }}
{{ else }}
   {{ if .IsDownloadView }}
       {{ if .IsPasswordView }}
          <title>{{.PublicName}}: {{ .Lang.T "downloadpw_title" }}</title>
	  <meta name="title" content="{{.PublicName}}">
    	  <meta name="description" content="{{ .Lang.T "downloadpw_title" }}">

    	  <meta property="og:title" content="{{.PublicName}}"/>
  	  <meta property="og:description" content="{{ .Lang.T "downloadpw_title" }}"/>
       {{ else }}
          <title>{{.PublicName}}: {{.Name}}</title>
	  <meta name="title" content="{{.PublicName}}: {{.Name}}">
    	  <meta name="description" content="{{.Size}}">

    	  <meta property="og:title" content="{{.Name}}"/>
  	  <meta property="og:description" content="{{.Size}}"/>
       {{end }}
  	  <meta property="og:url" content="{{.BaseUrl}}"/>
   {{ else }}
         <title>{{.PublicName}}</title>
   {{end }}
    {{ if .CustomContent.UseCustomCss }}
         <link  href="./custom/custom.v{{.CustomContent.Version}}.css" rel="stylesheet">
    {{ end }}
         <script src="./js/min/end2end_download.min.{{ template "js_e2eversion"}}.js"></script>
{{end}}
  </head>
  <body class="d-flex h-100 text-center text-white bg-dark">
{{ if .IsAdminView }}
<div style="position:fixed;top:0.5rem;right:0.75rem;z-index:9999;display:flex;align-items:center;gap:0.5rem;">
   {{ if .IsUserTabAvailable }}
  <span class="badge bg-secondary opacity-75">
    <i class="bi bi-person-fill"></i> {{.ActiveUser.Name}}
  </span>
  {{ end }}
  {{ template "language_selector" . }}
</div>
  <div class="d-flex w-100 h-100 p-3 mx-auto flex-column">
      <header class="masthead mb-auto">
        <div  style="max-width: 80em;  margin: 0 auto;"  class="inner">
          <h1>{{.PublicName}}</h1>
          <nav class="nav nav-masthead justify-content-center">
            <a class="nav-link {{ if eq .ActiveView 0}}active{{ end }}" href="./admin">{{ .Lang.T "nav_upload" }}</a>
            {{ if .ActiveUser.HasPermissionCreateFileRequests }}
            <a class="nav-link {{ if eq .ActiveView 4 }}active{{ end }}" href="./filerequests">{{ .Lang.T "nav_file_requests" }}</a>
            {{ end }}
            {{ if and .ActiveUser.HasPermissionManageUsers .IsUserTabAvailable }}
            <a class="nav-link {{ if eq .ActiveView 3 }}active{{ end }}" href="./users">{{ .Lang.T "nav_users" }}</a>
            {{ end }}
            {{ if .ShowApiMenu }}
            <a class="nav-link {{ if eq .ActiveView 2 }}active{{ end }}" href="./apiKeys">{{ .Lang.T "nav_api" }}</a>
            {{ end }}
            {{ if .ActiveUser.HasPermissionManageLogs }}
            <a class="nav-link {{ if eq .ActiveView 1 }}active{{ end }}" href="./logs">{{ .Lang.T "nav_status" }}</a>
            {{ end }}
            {{ if .IsLogoutAvailable }}<a class="nav-link" href="#" onclick="doLogout()">{{ .Lang.T "nav_logout" }}</a>{{ end }}
          </nav>
        </div>
      </header>
  <main style="margin-top: 2rem">
{{ else }}
<div style="position:fixed;top:0.5rem;right:0.75rem;z-index:9999;">
  {{ template "language_selector" . }}
</div>
  <div class="d-flex w-100 h-100 p-3 mx-auto flex-column">
  <header class="mb-auto">
    <div>
      <h1><a href="/index" style="text-decoration: none;display: block;">{{.PublicName}}</a></h1>
    </div>
  </header>
  <main>
{{ end }}
{{end}}

{{define "language_selector"}}
{{ if gt (len .Lang.Available) 1 }}
  <select class="form-select form-select-sm bg-dark text-white-50 border-secondary"
          style="width:auto;padding-top:0.1rem;padding-bottom:0.1rem;font-size:0.8rem;"
          aria-label="{{ .Lang.T "generic_language" }}"
          title="{{ .Lang.T "generic_language" }}"
          onchange="setLanguage(this.value)">
{{ range .Lang.Available }}
    <option value="{{ .Code }}" {{ if eq .Code $.Lang.Code }}selected{{ end }}>{{ .Name }}</option>
{{ end }}
  </select>
{{ end }}
{{end}}
